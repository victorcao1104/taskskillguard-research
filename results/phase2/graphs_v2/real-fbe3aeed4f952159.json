    },
    {
      "id": "n00021",
      "kind": "INSTR_ACTION",
      "operation": "file.read",
      "resource": "unknown",
      "resource_status": "unknown",
      "summary": "- **`evaluate` is code execution in the page's world.** Use it to read values. Never build the script from page-supplied strings.",
      "provenance": {
