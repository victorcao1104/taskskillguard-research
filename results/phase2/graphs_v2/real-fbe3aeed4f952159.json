    {
      "id": "n00004",
      "kind": "INSTR_ACTION",
      "operation": "file.read",
      "resource": "unknown",
      "resource_status": "unknown",
      "summary": "**This gives an agent real capability, so scope it deliberately.** The server hands the model a browser that persists logins, executes JavaScript in the page, and can stream its screen to a shareable URL. That is the point of the tool and also its blast radius: an agent that goes wrong here goes wrong inside a logged-in session. Run untrusted brows",
      "provenance": {
        "file": "SKILL.md",
        "line_start": 18,
        "line_end": 18
      },
      "scope": "SKILL.md",
      "authorization_source": false,
