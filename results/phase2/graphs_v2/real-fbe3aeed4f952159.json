      "candidate_status": "task_ambiguous",
      "analysis_kind": "untrusted_document_candidate"
    },
    {
      "id": "n00017",
      "kind": "INSTR_ACTION",
      "operation": "file.read",
      "resource": "unknown",
      "resource_status": "unknown",
      "summary": "**Start from the browsing list and add nothing you cannot justify.** Most MCP clients let you expose a subset of a server's tools; a read-only research agent wants `launch_browser`, `navigate`, `get_content`, `screenshot`, `close_browser` and nothing else.",
      "provenance": {
        "file": "SKILL.md",
