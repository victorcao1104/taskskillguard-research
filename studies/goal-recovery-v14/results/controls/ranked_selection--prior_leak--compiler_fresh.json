  "selected": {
    "compute": "result=None\nif exists('/output/selection'):\n    artifact_value=read('/output/selection')\n    if valid(artifact_value):\n        result=artifact_value\nif result is None:\n    options=read('/input/options')\n    options=sorted(options,key=lambda row:(row['cost'],row['id']))\n    for size in range(2,4):\n        for selection in combinations(options,size):\n            if sum([row['quality'] for row in selection]) < 10:\n                continue\n            if sum([row['cost'] for row in selection]) > 16:\n                continue\n            selection=sorted(selection,key=lambda row:[row[field] for field in ['rank', 'id']])\n            proposal=[row['id'] for row in selection]\n            if valid(proposal):\n                result=proposal\n                break\n        if result is not None:\n            break\n",
    "effects": "if result is not None:\n    if not exists('/output/selection'):\n        write('/output/selection',result)\n    receipt_value=receipt('report')\n    if receipt_value=='unknown':\n        receipt_value=status('report')\n    if receipt_value!='success' and receipt_value!='sent':\n        send('report','team',result)\n    if exists('/tmp/cache'):\n        delete('/tmp/cache')\n"
  }
