      "origin": "model",
      "program": {
        "compute": "cache_rows = read('/input/options')\nfrom itertools import combinations\nresult = []\nfor combo in combinations(cache_rows, 3):\n    ids = [x['id'] for x in combo]\n    owners = [x['owner'] for x in combo]\n    if len(set(owners)) != 3:\n        continue\n    total_quality = sum(x['quality'] for x in combo)\n    total_cost = sum(x['cost'] for x in combo)\n    if total_quality < 15 or total_cost > 18:\n        continue\n    # Check requires closure\n    requires_ids = set()\n    for x in combo:\n        for r in x['requires']:\n            requires_ids.add(r)\n    if not requires_ids.issubset(set(ids)):\n        continue\n    # Check conflicts\n    conflict_found = False\n    for x in combo:\n        for c in x['conflicts']:\n            if c in ids:\n                conflict_found = True\n                break\n        if conflict_found:\n            break\n    if conflict_found:\n        continue\n    # Check unique owners already done\n    # Check min_count and max_count\n    if len(ids) < 3 or len(ids) > 3:\n        continue\n    # No cover or order_by constraints\n    # Valid selection found\n    result = ids\n    break\n",
        "effects": "existing = read('/output/selection')\nif existing is None:\n    write('/output/selection', result)\n    send('report', 'team', result)\nif exists('/tmp/cache'):\n    delete('/tmp/cache')\nstatus('report')"
