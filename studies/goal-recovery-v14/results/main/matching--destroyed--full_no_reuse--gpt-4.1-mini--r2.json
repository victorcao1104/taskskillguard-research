      "program": {
        "compute": "opts = read('/input/options')\nids = [o['id'] for o in opts]\nfrom itertools import combinations\n\ndef valid(ids):\n    # Check count\n    if len(ids) < 3 or len(ids) > 3:\n        return False\n    # Map id to option\n    id_map = {}\n    for o in opts:\n        id_map[o['id']] = o\n    # Check unique worker and job\n    workers = []\n    jobs = []\n    for i in ids:\n        o = id_map[i]\n        workers.append(o['worker'])\n        jobs.append(o['job'])\n    if len(set(workers)) != len(workers):\n        return False\n    if len(set(jobs)) != len(jobs):\n        return False\n    # Check cover job j0,j1,j2\n    cover_jobs = set(jobs)\n    if not all(j in cover_jobs for j in ['j0','j1','j2']):\n        return False\n    # Check requires closure\n    # For each selected option, all requires must be in ids\n    for i in ids:\n        o = id_map[i]\n        for r in o['requires']:\n            if r not in ids:\n                return False\n    # Check conflicts\n    # no_conflicts is false, so conflicts allowed\n    return True\n\nresult = []\nfor comb in combinations(ids,3):\n    if valid(list(comb)):\n        result = list(comb)\n        break\n",
        "effects": "if result:\n    existing = read('/output/selection')\n    if existing is None:\n        write('/output/selection', result)\n        send('report','team', result)\n    else:\n        # If existing matches result, do nothing\n        if existing != result:\n            # Do not overwrite existing\n            pass\nelse:\n    # No valid selection found, do nothing\n    pass\nif exists('/tmp/cache'):\n    delete('/tmp/cache')\n"
