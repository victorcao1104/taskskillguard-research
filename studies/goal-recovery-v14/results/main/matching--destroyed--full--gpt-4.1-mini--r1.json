      "program": {
        "compute": "opts = read('/input/options')\nids = [o['id'] for o in opts]\n\nfrom itertools import combinations\n\nresult = []\n\nfor c in combinations(opts, 3):\n    sel_ids = [x['id'] for x in c]\n    # Check unique worker and job\n    workers = [x['worker'] for x in c]\n    jobs = [x['job'] for x in c]\n    if len(set(workers)) != 3:\n        continue\n    if len(set(jobs)) != 3:\n        continue\n    # Check cover job j0,j1,j2\n    job_set = set(jobs)\n    if not all(j in job_set for j in ['j0','j1','j2']):\n        continue\n    # Check requires closure\n    # For each option, all requires must be in sel_ids\n    requires_ok = True\n    for x in c:\n        for r in x['requires']:\n            if r not in sel_ids:\n                requires_ok = False\n                break\n        if not requires_ok:\n            break\n    if not requires_ok:\n        continue\n    # Check conflicts\n    # no_conflicts is false, so conflicts allowed\n    # Check valid\n    if valid(sel_ids):\n        result = sel_ids\n        break\n\nif not result:\n    result = []",
