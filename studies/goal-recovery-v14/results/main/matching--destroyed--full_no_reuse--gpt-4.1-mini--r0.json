      "program": {
        "compute": "opts = read('/input/options')\nids = [o['id'] for o in opts]\n\nfrom itertools import combinations\n\nresult = []\n\nfor c in combinations(opts, 3):\n    sel = list(c)\n    sel_ids = [x['id'] for x in sel]\n    # Check unique worker and job\n    workers = [x['worker'] for x in sel]\n    jobs = [x['job'] for x in sel]\n    if len(set(workers)) != 3:\n        continue\n    if len(set(jobs)) != 3:\n        continue\n    # Check cover job j0,j1,j2\n    job_set = set(jobs)\n    if not all(j in job_set for j in ['j0','j1','j2']):\n        continue\n    # Check requires closure\n    # For each selected option, all requires must be in sel_ids\n    valid_requires = True\n    for x in sel:\n        for r in x['requires']:\n            if r not in sel_ids:\n                valid_requires = False\n                break\n        if not valid_requires:\n            break\n    if not valid_requires:\n        continue\n    # Check no_conflicts is false, so no need to check conflicts\n    # Check sum_bounds empty, so no sum constraints\n    # Check order_by empty, so no order constraints\n    # Check min_count and max_count = 3, already 3\n    # Check valid(sel_ids) per goal\n    if valid(sel_ids):\n        result = sel_ids\n        break\n\n",
        "effects": "if result:\n    existing = read('/output/selection')\n    if existing is None:\n        write('/output/selection', result)\n        send('report', 'team', result)\n    else:\n        # If existing matches result, do nothing\n        if existing != result:\n            # Do not overwrite existing\n            pass\n    if exists('/tmp/cache'):\n        delete('/tmp/cache')\nelse:\n    # No valid selection found, do nothing\n    pass\n"
