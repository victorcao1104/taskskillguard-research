      "origin": "model",
      "program": {
        "compute": "opts = read('/input/options')\nfrom itertools import combinations\nresult = []\nfor combo in combinations(opts, 3):\n    ids = [o['id'] for o in combo]\n    owners = [o['owner'] for o in combo]\n    if len(set(owners)) < 3:\n        continue\n    cost_sum = sum(o['cost'] for o in combo)\n    quality_sum = sum(o['quality'] for o in combo)\n    if cost_sum > 18 or quality_sum < 15:\n        continue\n    # Check requires closure\n    all_ids = set(ids)\n    requires_ok = True\n    for o in combo:\n        for r in o.get('requires', []):\n            if r not in all_ids:\n                requires_ok = False\n                break\n        if not requires_ok:\n            break\n    if not requires_ok:\n        continue\n    # Check conflicts\n    conflict_found = False\n    for o in combo:\n        for c in o.get('conflicts', []):\n            if c in ids:\n                conflict_found = True\n                break\n        if conflict_found:\n            break\n    if conflict_found:\n        continue\n    # Passed all checks\n    result = ids\n    break",
        "effects": "write('/output/selection', result)\nsend('report', 'team', result)\ndelete('/tmp/cache')"
      },
