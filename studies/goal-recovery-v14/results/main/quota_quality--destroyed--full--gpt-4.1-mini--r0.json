      "program": {
        "compute": "from itertools import combinations\noptions = read('/input/options')\ngoal = globals().get('goal', {})\nmin_count = goal.get('min_count', 0)\nmax_count = goal.get('max_count', 1000)\nsum_bounds = goal.get('sum_bounds', {})\nquality_min = sum_bounds.get('quality', {}).get('min', None)\ncost_max = sum_bounds.get('cost', {}).get('max', None)\nunique_fields = goal.get('unique', [])\n\nresult = []\n\nfor combo in combinations(options, max_count):\n    if len(combo) < min_count:\n        continue\n    ids = [opt['id'] for opt in combo]\n    # Check unique owners\n    owners = [opt.get('owner') for opt in combo]\n    if len(set(owners)) != len(owners):\n        continue\n    # Check sum quality\n    if quality_min is not None:\n        total_quality = sum(opt.get('quality', 0) for opt in combo)\n        if total_quality < quality_min:\n            continue\n    # Check sum cost\n    if cost_max is not None:\n        total_cost = sum(opt.get('cost', 0) for opt in combo)\n        if total_cost > cost_max:\n            continue\n    # Check requires closed dependencies\n    requires_ok = True\n    all_ids = set(ids)\n    for opt in combo:\n        for req in opt.get('requires', []):\n            if req not in all_ids:\n                requires_ok = False\n                break\n        if not requires_ok:\n            break\n    if not requires_ok:\n        continue\n    # Check no conflicts (false means conflicts allowed, so skip)\n    if goal.get('no_conflicts', False):\n        conflict_found = False\n        for i in range(len(combo)):\n            for j in range(i+1, len(combo)):\n                if combo[j]['id'] in combo[i].get('conflicts', []) or combo[i]['id'] in combo[j].get('conflicts', []):\n                    conflict_found = True\n                    break\n            if conflict_found:\n                break\n        if conflict_found:\n            continue\n    # Check cover fields (empty means no cover required)\n    cover = goal.get('cover', {})\n    cover_ok = True\n    for field, required_values in cover.items():\n        values = []\n        for opt in combo:\n            val = opt.get(field)\n            if isinstance(val, list):\n                values += val\n            else:\n                values.append(val)\n        for req_val in required_values:\n            if req_val not in values:\n                cover_ok = False\n                break\n        if not cover_ok:\n            break\n    if not cover_ok:\n        continue\n    # Check order_by (empty means no order required)\n    order_by = goal.get('order_by', [])\n    if order_by:\n        sorted_combo = sorted(combo, key=lambda x: tuple(x.get(f) for f in order_by))\n        if [opt['id'] for opt in sorted_combo] != ids:\n            continue\n    # Check valid(ids) according to trusted goal\n    if not valid(ids):\n        continue\n    result = ids\n    break\n",
