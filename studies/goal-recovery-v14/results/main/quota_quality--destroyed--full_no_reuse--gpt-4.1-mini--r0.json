      "program": {
        "compute": "options = read('/input/options')\nfrom itertools import combinations\nresult = []\nfor combo in combinations(options, 3):\n    ids = [opt['id'] for opt in combo]\n    owners = [opt['owner'] for opt in combo]\n    if len(set(owners)) != 3:\n        continue\n    total_quality = sum(opt['quality'] for opt in combo)\n    total_cost = sum(opt['cost'] for opt in combo)\n    if total_quality < 15 or total_cost > 18:\n        continue\n    # Check requires closure\n    requires_ok = True\n    selected_ids = set(ids)\n    for opt in combo:\n        for req in opt['requires']:\n            if req not in selected_ids:\n                requires_ok = False\n                break\n        if not requires_ok:\n            break\n    if not requires_ok:\n        continue\n    # no_conflicts is false, so conflicts ignored\n    # cover empty, order_by empty\n    # unique owners checked\n    # min_count and max_count 3 checked by combinations\n    # valid check\n    if valid(ids):\n        result = ids\n        break",
        "effects": "write('/output/selection', result)\nsend('report', 'team', result)\ndelete('/tmp/cache')"
      },
