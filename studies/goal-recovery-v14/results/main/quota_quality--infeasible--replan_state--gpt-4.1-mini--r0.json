      "program": {
        "compute": "options = read('/input/options')\nfrom itertools import combinations\nresult = []\nfor combo in combinations(options, 3):\n    ids = [opt['id'] for opt in combo]\n    owners = [opt['owner'] for opt in combo]\n    qualities = [opt['quality'] for opt in combo]\n    costs = [opt['cost'] for opt in combo]\n    tags_all = []\n    for opt in combo:\n        tags_all += opt['tags']\n    # Check unique owners\n    unique_owners = True\n    for i in range(len(owners)):\n        for j in range(i+1, len(owners)):\n            if owners[i] == owners[j]:\n                unique_owners = False\n    if not unique_owners:\n        continue\n    # Check cover tags\n    cover_tags = goal['cover'].get('tags', [])\n    cover_ok = True\n    for tag in cover_tags:\n        if tag not in tags_all:\n            cover_ok = False\n    if not cover_ok:\n        continue\n    # Check sum bounds\n    quality_sum = sum(qualities)\n    cost_sum = sum(costs)\n    if quality_sum < goal['sum_bounds']['quality']['min']:\n        continue\n    if cost_sum > goal['sum_bounds']['cost']['max']:\n        continue\n    # Check count\n    if len(ids) < goal['min_count'] or len(ids) > goal['max_count']:\n        continue\n    # no_conflicts is false, so conflicts allowed\n    # closed_dependencies is false, so no check\n    # Check valid\n    if valid(ids):\n        result = ids\n        break",
        "effects": "write('/output/selection', result)\nsend('report', 'team', result)\ndelete('/tmp/cache')"
      },
