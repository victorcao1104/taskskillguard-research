      "origin": "model",
      "program": {
        "compute": "opts = read('/input/options')\nfrom itertools import combinations\nresult = []\nfor combo in combinations(opts, 3):\n    ids = [o['id'] for o in combo]\n    owners = [o['owner'] for o in combo]\n    if len(set(owners)) < 3:\n        continue\n    total_quality = sum(o['quality'] for o in combo)\n    total_cost = sum(o['cost'] for o in combo)\n    if total_quality < 15 or total_cost > 18:\n        continue\n    # Check requires closure\n    requires_ok = True\n    ids_set = set(ids)\n    for o in combo:\n        for r in o.get('requires', []):\n            if r not in ids_set:\n                requires_ok = False\n                break\n        if not requires_ok:\n            break\n    if not requires_ok:\n        continue\n    # no_conflicts is false, so conflicts ignored\n    result = ids\n    break",
        "effects": "write('/output/selection', result)\nsend('report', 'team', result)\ndelete('/tmp/cache')"
      },
