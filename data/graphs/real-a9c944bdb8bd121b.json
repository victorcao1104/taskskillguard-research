    },
    {
      "id": "n0016",
      "kind": "INSTR_ACTION",
      "operation": "network.post",
      "resource": "unknown",
      "summary": "- Choose `overlay_font_color` for contrast against the generated frame, not brand aesthetics. If the screenshot/product surface is light or unknown, use `#111111`; use `#ffffff` only on clearly dark footage. Post-flight OCR must be able to read the overlay.",
      "provenance": {
        "file": "SKILL.md",
