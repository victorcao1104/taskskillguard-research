    {
      "id": "n0021",
      "kind": "INSTR_ACTION",
      "operation": "network.get",
      "resource": "unknown",
      "summary": "Call `generate_reference_video` once for the native `9:16` ad, then run Step 8 deterministic overlays once to produce `guarded_video_url`. Do not re-run product fetch, avatar analysis, screenshot capture, avatar cartoonization, Seedance/Kling generation, deterministic overlays, or any other expensive provider call for extra variants.",
      "provenance": {
        "file": "SKILL.md",
        "line_start": 362,
        "line_end": 362
      },
      "candidate_status": "task_ambiguous",
      "authorization_source": false
    },
    {
      "id": "n0022",
      "kind": "INSTR_ACTION",
      "operation": "file.write",
      "resource": "unknown",
      "summary": "- For `16:9` and `1:1`, call `edit_reframe(video_url=guarded_video_url, target_aspect=\"<aspect>\", fill_mode=\"blur\")` and save each returned URL into `variant_sources`. Blur fill preserves the full native vertical ad over a blurred background instead of cutting off the creator or captions.",
