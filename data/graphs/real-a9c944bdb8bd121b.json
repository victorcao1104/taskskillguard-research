    {
      "id": "n0015",
      "kind": "INSTR_ACTION",
      "operation": "network.post",
      "resource": "unknown",
      "summary": "Before captions, add readable brand/spec copy with deterministic post-generation overlays. This is deliberately separate from the Seedance prompt because video-model text rendering corrupts brand wordmarks and spec labels.",
      "provenance": {
        "file": "SKILL.md",
