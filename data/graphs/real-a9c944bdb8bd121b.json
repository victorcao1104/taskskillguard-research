    {
      "id": "n0003",
      "kind": "INSTR_ACTION",
      "operation": "network.post",
      "resource": "unknown",
      "summary": "Default to Seedance for UGC selfie/talking-head ads because it handles native lip-sync, single-prompt multi-beat pacing, and optional 3:4 output well. Use Kling when the caller explicitly passes `provider=kling`, or after Seedance exhausts the capped cartoonized retry only if the user chooses Kling from the stop message. Kling's tradeoff is stricte",
      "provenance": {
        "file": "SKILL.md",
        "line_start": 77,
        "line_end": 77
      },
      "candidate_status": "task_ambiguous",
      "authorization_source": false
    },
    {
      "id": "n0004",
      "kind": "INSTR_ACTION",
      "operation": "network.get",
      "resource": "unknown",
      "summary": "> - **Product URL** — page to fetch for product name, category, visual references, and language",
      "provenance": {
        "file": "SKILL.md",
        "line_start": 87,
        "line_end": 87
      },
      "candidate_status": "task_ambiguous",
      "authorization_source": false
    },
    {
      "id": "n0005",
      "kind": "INSTR_ACTION",
      "operation": "network.get",
      "resource": "unknown",
      "summary": "### 1. Fetch + categorize",
      "provenance": {
        "file": "SKILL.md",
        "line_start": 93,
