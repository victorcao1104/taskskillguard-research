    {
      "id": "n0002",
      "kind": "INSTR_ACTION",
      "operation": "file.read",
      "resource": "unknown",
      "summary": "- Call `task_status({task_id})` in a tight loop until terminal (`completed | failed | cancelled`). No manual sleep and no Bash polling; the worker holds each status call open.",
      "provenance": {
